---
import '../styles/tailwind.css'
import '../assets/scss/index.scss'
import SiteMeta from '@components/SiteMeta.astro'

const {
  title = 'Accessible Astro Dashboard',
  description = 'An Accessible Dashboard Theme for Astro including a login page, a dashboard page and several other pages and components.',
  url = Astro.site,
  image = '/social-preview-image.png',
  author = 'Incluud',
} = Astro.props
---

<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />

    <!-- favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <SiteMeta {...{ title, description, url, image, author }} />
  </head>
  <body>
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  html body {
    background-color: var(--neutral-100);
  }
</style>
