---
import { Notification } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'

// Check for error parameter from middleware
const url = new URL(Astro.request.url);
const error = url.searchParams.get('error');
---

<form class="login-form space-content" method="post" action="/login">
  {error && (
    <Notification type="warning">
      <Fragment>
        <Icon name="lucide:frown" />
        <p class="size-12">
          {error === 'invalid' 
            ? 'Incorrect email and password combination. Please try again.'
            : 'Server error occurred. Please try again.'
          }
        </p>
      </Fragment>
    </Notification>
  )}
  <div class="login-form__controls">
    <label for="email">Email</label>
    <input type="email" name="email" required>
  </div>
  <div class="login-form__controls">
    <label for="password">Password</label>
    <input type="password" name="password" required>
  </div>
  <button class="button color-secondary behavior-full" type="submit">Login</button>
  <label class="checkbox">
    <input type="checkbox" name="remember">
    <span>Remember me</span>
  </label>
  <a href="#">Forgot password?</a>
</form> 


<style lang="scss" is:global>
  @use '../assets/scss/base/border' as *;
  @use '../assets/scss/base/space' as *;

  .login-form {
    label {
      display: block;
      margin-bottom: $space-8;
    }

    input {
      width: 100%;
      @include radius-small;
    }

    input {
      padding: $space-8;
      border: 2px solid var(--neutral-600);
    }

    .checkbox {
      display: flex;
      align-items: center;
      gap: $space-4;

      input {
        width: auto;
      }
    }
  }
</style>