---
import { Button, Checkbox, Form, Heading, Input, Link, Notification } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'

// Check for error parameter from middleware
const url = new URL(Astro.request.url)
const error = url.searchParams.get('error')
---

<div class="flex flex-col gap-8">
  <div>
    <Heading level="h1" size="h3" class="mb-4">Login</Heading>
    <Form method="post" action="/login">
      {
        error && (
          <Notification type="warning">
            <Icon name="lucide:frown" />
            <p>
              {error === 'invalid'
                ? 'Incorrect email and password combination. Please try again.'
                : 'Server error occurred. Please try again.'}
            </p>
          </Notification>
        )
      }
      <Input name="email" label="Email" type="email" value="admin@astro.demo" />
      <Input name="password" label="Password" type="password" value="Astronaut570" />
      <div class="flex items-center justify-between">
        <Button htmlType="submit" type="secondary">Sign in</Button>
        <Link href="#">Forgot password?</Link>
      </div>
    </Form>
  </div>
</div>
