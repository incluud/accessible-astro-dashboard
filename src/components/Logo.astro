---
import { Image } from 'astro:assets'
import logo from '@assets/img/logo.svg'

/**
 * Logo Component
 *
 * @description Logo description
 */
interface Props {
  /**
   * Whether to load the image eagerly or lazily
   * @default 'eager'
   */
  loading?: 'eager' | 'lazy'
  /**
   * The title of the logo
   * @default 'Accessible Astro'
   */
  title?: string
  /**
   * The description of the logo
   * @default 'Dashboard theme for Astro'
   */
  description?: string
}

const { loading = 'eager', title = 'Accessible Astro', description = 'Dashboard theme for Astro' }: Props = Astro.props
---

<div class="logo flex items-center gap-3">
  <Image src={logo} alt="Accessible Astro Logo" width="46" height="46" loading={loading} />
  <p class="flex flex-col">
    <span class="text-base font-bold">{title}</span>
    <span class="text-sm">{description}</span>
  </p>
</div>
