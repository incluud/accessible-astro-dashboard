---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Logo from '@components/Logo.astro'
import LoginForm from '@components/LoginForm.astro'
import { Image } from 'astro:assets'
import { Link } from 'accessible-astro-components'

const { src = '/login-background.webp' } = Astro.props
---

<DefaultLayout title="Login">
  <section class="overflow-x-hidden">
    <div class="grid h-dvh grid-cols-1 md:grid-cols-[500px_1fr]">
      <div class="flex flex-col justify-between gap-4 overflow-y-auto border-r-2 px-20 py-10">
        <Logo />
        <LoginForm />
        <p class="text-sm">
          Made with ❤️ by <Link href="https://github.com/markteekman">Mark Teekman</Link>. Part of <Link
            href="https://www.incluud.dev">Incluud</Link
          >.
        </p>
      </div>
      <div class="hidden md:block">
        <Image class="h-dvh w-full object-cover" src={src} alt="" width={1000} height={1000} />
      </div>
    </div>
  </section>
</DefaultLayout>
