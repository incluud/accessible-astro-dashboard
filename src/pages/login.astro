---
import LoginLayout from '../layouts/LoginLayout.astro'
import LoginForm from '../components/LoginForm.astro'
import { Notification } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
---

<LoginLayout title="Login">
  <section class="bg-neutral-100">
    <div class="login">
      <div class="login__inner reveal h-screen">
        <div class="inner__brand">
          <div class="radius-large space-8 bg-neutral-900">
            <img class="brand__logo radius-large" src="/astro-logo.svg" alt="" />
          </div>
          <div class="brand__text">
            <span>Astro Dashboard</span>
            <span>An Accessible Astro Theme</span>
          </div>
        </div>
        <div class="inner__form space-content">
          <Notification>
            <Fragment>
              <Icon name="lucide:info" />
              <p class="size-14">Log in using <strong>admin@astro.demo</strong> and <strong>Astronaut570</strong>.</p>
            </Fragment>
          </Notification>
          <div class="space-content">
            <h1>Login</h1>
            <LoginForm />
          </div>
        </div>
        <div class="login__footer text-neutral-700">
          <p><em>Build fast dashboards, faster.</em></p>
        </div>
      </div>
      <div class="login__background h-screen"></div>
    </div>
  </section>
</LoginLayout>

