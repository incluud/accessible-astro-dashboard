---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import { Heading } from 'accessible-astro-components'
---

<DefaultLayout title="Dashboard">
  <div class="px-4 py-8">
    <Heading level="h1" size="h4">Dashboard</Heading>
    <p>Welcome to the dashboard. This is where you can manage your account and settings.</p>
    <div class="my-8 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      <div class="rounded-lg border border-neutral-200 p-4">
        <Heading level="h2" size="h5">Recent Activity</Heading>
        <p>You have 10 new messages.</p>
      </div>
      <div class="rounded-lg border border-neutral-200 p-4">
        <Heading level="h2" size="h5">Users</Heading>
        <p>You have 100 users.</p>
      </div>
      <div class="rounded-lg border border-neutral-200 p-4">
        <Heading level="h2" size="h5">Settings</Heading>
        <p>You have 10 settings.</p>
      </div>
    </div>
  </div>
</DefaultLayout>
